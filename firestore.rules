rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "subairnurudeen20@gmail.com";
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 &&
             data.excerpt is string &&
             data.category is string &&
             data.authorId == request.auth.uid &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    // --- Collections ---

    match /test/connection {
      allow read: if true;
    }

    match /articles/{articleId} {
      allow read: if true; // Publicly readable news
      allow create: if isSignedIn() && (isAdmin() || isValidArticle(incoming()));
      allow update: if isSignedIn() && (isAdmin() || (isOwner(existing().authorId) && isValidArticle(incoming())));
      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing().authorId));
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /experts/{expertId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /spotlight/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create, update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if false; // Profiles shouldn't be deleted by users easily
    }
  }
}
