{
  "entities": {
    "Article": {
      "title": "Article",
      "description": "A news article published on the platform.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The headline of the article." },
        "excerpt": { "type": "string", "description": "A short summary of the article." },
        "content": { "type": "string", "description": "Full markdown content of the article." },
        "category": { "type": "string", "description": "The category of the article (e.g., Tech, FinTech)." },
        "authorId": { "type": "string", "description": "UID of the author." },
        "authorName": { "type": "string", "description": "Display name of the author." },
        "date": { "type": "string", "description": "Published date string." },
        "readTime": { "type": "string", "description": "Estimated reading time." },
        "image": { "type": "string", "description": "URL to the article image." },
        "featured": { "type": "boolean", "description": "Whether the article is featured on the hero section." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." }
      },
      "required": ["title", "excerpt", "category", "authorId", "createdAt"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile for a user/author.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["reader", "contributor", "editor"] },
        "bio": { "type": "string" },
        "bookmarks": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["displayName"]
    },
    "NewsEvent": {
      "title": "Event",
      "description": "An upcoming event or seminar.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "image": { "type": "string" },
        "registrationLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "location", "date", "createdAt"]
    },
    "Expert": {
      "title": "Expert",
      "description": "Industry expert or contributor.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "image": { "type": "string" },
        "twitter": { "type": "string" },
        "linkedin": { "type": "string" },
        "website": { "type": "string" },
        "contributionsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "title", "image", "createdAt"]
    },
    "SpotlightStory": {
      "title": "Spotlight Story",
      "description": "Featured founder story.",
      "type": "object",
      "properties": {
        "founderName": { "type": "string" },
        "companyName": { "type": "string" },
        "title": { "type": "string" },
        "story": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["founderName", "companyName", "title", "story", "image", "createdAt"]
    }
  },
  "firestore": {
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Collection of news articles."
    },
    "/events/{eventId}": {
      "schema": "NewsEvent",
      "description": "Collection of events."
    },
    "/experts/{expertId}": {
      "schema": "Expert",
      "description": "Collection of experts."
    },
    "/spotlight/{storyId}": {
      "schema": "SpotlightStory",
      "description": "Collection of spotlights."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    }
  }
}
